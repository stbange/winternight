#ffffff #e4ecfa #c9d6f2 #b8c6e8 #9fb0d8 #8494c4 #6b7cab #536294
#3d4a75 #2c375c
# Pine / forest
#0e1f1a #173328 #24493a #2f5c49 #0a1410
