#2affb0 #7dffc0 #1a5a50 #8fb8dc #a8d0ee
# Gold / cloth
#c8a040 #6a1a1a #3c3c44
# Winternight prefabs. Coordinates in metres, y = 0 at the placement ground.
# Later primitives override earlier ones; "carve" removes material.
#   box mat x0 y0 z0 x1 y1 z1          cyl mat cx cz y0 y1 r
#   hcylx mat cy cz x0 x1 r            hcylz mat cx cy z0 z1 r
#   cone mat cx cz y0 y1 r             sphere mat cx cy cz r
#   gablex mat x0 y0 z0 x1 y1 z1       crenel mat x0 y0 z0 x1 y1 z1 period

# Castle Hearthholm: the front faces -z (towards the road).
prefab castle_hearthholm
  # curtain walls with foundations reaching into the hill
  box castle-stone -16 -6 0 16 8 2
  box castle-stone -16 -6 0 -14 8 30
  box castle-stone 14 -6 0 16 8 30
  box castle-stone -16 -6 28 16 8 30
  crenel castle-stone -16 8 0 16 9 0.6 1.0
  crenel castle-stone -16 8 0 -15.4 9 30 1.0
  crenel castle-stone 15.4 8 0 16 9 30 1.0
  # courtyard floor
  box castle-stone -14 -6 2 14 0.2 28
  # corner towers with slate roofs
  cyl castle-stone -15 1 -6 12 3
  cyl castle-stone 15 1 -6 12 3
  cyl castle-stone -15 29 -6 12 3
  cyl castle-stone 15 29 -6 12 3
  cone slate -15 1 12 17.5 3.6
  cone slate 15 1 12 17.5 3.6
  cone slate -15 29 12 17 3.6
  cone slate 15 29 12 17 3.6
  # tower windows (arrow slits glowing)
  box window-glow -15.3 7 -2.05 -14.7 8.6 -1.85
  box window-glow 14.7 7 -2.05 15.3 8.6 -1.85
  # gatehouse
  box castle-stone -4.5 -6 -1.5 4.5 11 3.5
  crenel castle-stone -4.5 11 -1.5 4.5 12 -0.9 1.0
  carve box -1.7 0.2 -1.7 1.7 3.9 30
  box timber -1.7 0.2 0.6 1.7 3.8 1.0
  box iron -1.7 3.4 0.55 1.7 3.6 1.05
  box window-glow -0.5 6.2 -1.65 0.5 7.6 -1.45
  box window-glow -3.2 6.2 -1.65 -2.4 7.4 -1.45
  box window-glow 2.4 6.2 -1.65 3.2 7.4 -1.45
  # torches beside the gate
  box fire -2.3 2.6 -1.9 -2.0 3.1 -1.6
  box fire 2.0 2.6 -1.9 2.3 3.1 -1.6
  box timber -2.25 2.0 -1.75 -2.05 2.6 -1.5
  box timber 2.05 2.0 -1.75 2.25 2.6 -1.5
  # the keep with the great hall
  box castle-stone -9 0 12 9 18 26
  gablex slate -9.5 18 11.5 9.5 24 26.5
  box window-glow -7 10 11.8 -6 12 12.05
  box window-glow -3.5 10 11.8 -2.5 12 12.05
  box window-glow 2.5 10 11.8 3.5 12 12.05
  box window-glow 6 10 11.8 7 12 12.05
  box window-glow -7 14.5 11.8 -6 16 12.05
  box window-glow -3.5 14.5 11.8 -2.5 16 12.05
  box window-glow 2.5 14.5 11.8 3.5 16 12.05
  box window-glow 6 14.5 11.8 7 16 12.05
  box window-glow -1 13 11.8 1 16.5 12.05
  # keep tower
  cyl castle-stone 6 24 0 26 2.6
  cone slate 6 24 26 31.5 3.1
  box window-glow 5.6 20 21.35 6.4 21.6 21.5
  # chimney with a warm glow
  box castle-stone -5 18 17 -3.6 26 18.4
  box fire -4.7 25.6 17.3 -3.9 26.1 18.1
end

# A rocky ridge across the valley; the road passes through a narrow gap.
prefab ridge_gap
  box stone -70 -2 -3 -1.9 5.2 3
  box stone 1.9 -2 -3 70 5.2 3
  sphere stone -3.2 3.2 0 2.0
  sphere stone 3.4 3.4 0.4 2.2
  sphere stone -9 3.4 -0.5 2.6
  sphere stone 9.5 3.6 0.6 2.8
  sphere stone -18 3.5 0.3 3.0
  sphere stone 19 3.4 -0.2 2.9
  sphere stone -30 3.2 0.2 3.2
  sphere stone 31 3.3 0.2 3.1
  sphere stone -44 3.4 0.0 3.4
  sphere stone 45 3.2 0.1 3.3
  sphere stone -58 3.3 0.0 3.0
  sphere stone 59 3.5 0.0 3.2
end

# A pine fallen across the road, wedged into the gap.
prefab fallen_pine
  hcylx pine-wood 0.42 -0.2 -3.2 3.6 0.42
  box pine-needles 1.9 0.2 -1.4 3.2 1.4 1.0
  box pine-needles -3.0 0.3 -0.9 -2.0 1.0 0.6
  box pine-wood -1.2 0.5 -0.35 -1.0 1.2 -0.15
  box pine-wood 0.8 0.5 -0.3 1.0 1.1 -0.1
end
# Prologue - "The Road to Hearthholm" (spec game-flow: Prologue vertical slice).
# The warrior walks a snowy forest road at night towards the castle.
scene prologue
seed 1234
bounds -60 -6 -26 60 44 214
chunks_y -1 14

terrain 0.0 2.4 26.0
snow 0.45 0.15
hill 0 214 46 9.5
hill -40 120 30 5
hill 46 140 26 4
road 3.4 6.5 0.011 -40 196
forest 2.6 0.66 2.2
tracks -16 38 14 44

place ridge_gap road 64
place fallen_pine road 64 0 0.05
place castle_hearthholm road 196

moon -0.62 0.48 -0.42 #9fb4e0 1.1
sky #05070f #16204a
fog #0b1026 0.030
fire #ffb050
ambient 0.15
snowfall 0.04 700

spawn 0 -18 0
trigger gate -4 -2 188 4 8 195.5 reach_gate
event reach_gate message "Castle Hearthholm"
event reach_gate complete
# The benchmark / opening shot (docs/concept/visual-style.md) on the Mobile
# preset; also checks that only palette colours reach the screen
# (spec retro-rendering: Only palette colours on screen).
scene prologue
seed 1234
preset mobile
at 2 capture benchmark_road tolerance 24 maxdiff 2 palette 1
end 3
# spec platform-targets: Same replay, same result everywhere. The checksums
# below must be identical on Linux, Windows and the web build (task 11.1).
scene prologue
seed 1234
preset mobile
at 1 autopilot run
at 300 autopilot run chop 40
at 600 expect_checksum 6fc0c750
at 900 expect_checksum 7825d4b3
end 901
# spec game-flow: Prologue can be completed / Blocked road (task 9.3, 9.6).
# The autopilot walks the road; the fallen pine blocks it until it is chopped.
scene prologue
seed 1234
preset mobile
at 1 autopilot run
at 1200 expect player.z > 50
at 1800 expect player.z < 63.5
at 1801 autopilot run chop 28
at 2200 expect player.z > 66
at 2200 capture chopped_log tolerance 24 maxdiff 3
at 2201 autopilot run
at 6600 expect complete
end 6601
# Debug helper: prints the game state every step (compare native vs web).
scene prologue
seed 1234
preset mobile
trace 1
at 1 autopilot run
at 300 autopilot run chop 40
end 901
# Golden images for the night look (spec night-lighting, snow-simulation, blood-effects).
scene prologue
seed 1234
preset mobile
# Castle windows glowing through the forest (spec: Windows glow from afar)
at 1 teleport -2.9 ground 180 0.35
at 1 camera -3.5 4.5 176 0.35 0.05
at 2 stream
at 3 capture castle_windows tolerance 24 maxdiff 2
# Night sky; the same capture 100 m further on proves stars stay in place
at 4 teleport 0.15 ground 140 0
at 4 camera 0.15 30 140 0.0 1.45
at 5 stream
at 6 capture night_sky tolerance 24 maxdiff 1
at 7 teleport 0.15 ground 40 0
at 7 camera 1.88 30 40 0.0 1.45
at 8 stream
at 9 capture night_sky tolerance 24 maxdiff 1
# A pine and its moon shadow on the snow, seen from above
at 10 teleport 8 ground 6 0
at 10 camera 8.0 3.2 14.5 0.0 -0.35
at 11 stream
at 12 capture moon_shadow_pine tolerance 24 maxdiff 2
# Blood on snow
at 13 teleport 6.35 ground 24 0
at 13 camera 6.35 2.2 28.2 0.0 -0.75
at 14 stream
at 15 blood 6.35 0.6 30.0 9
at 200 capture blood_on_snow tolerance 24 maxdiff 3
# Snowfall over the road
at 201 teleport -5.3 ground -18 0
at 201 follow
at 202 stream
at 380 capture snowfall_road tolerance 24 maxdiff 4
end 381
