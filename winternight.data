#1c1e2a #2a2a35 #34343f #454555 #5a5a6a #6a6a7a #8a8e9a #a8acb8
# Earth / wood / leather / fur
#1a1410 #241e1a #2e2622 #3a2618 #4a3020 #5a4a3a #6e5c48 #8a7258
